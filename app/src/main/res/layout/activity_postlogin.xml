<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/image1"
        android:contentDescription="@string/app_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top Bar -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/food_fit4"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/ubuntu_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"/>

    <ImageView
        android:id="@+id/calendarIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_calendar"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        app:tint="#FFFFFF" />

    <!-- Eaten / Total Card -->
    <LinearLayout
        android:id="@+id/caloriesCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eaten_total"
            android:textSize="14sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/caloriesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Breakfast -->
    <LinearLayout
        android:id="@+id/breakfastCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/caloriesCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/todo3"
            android:src="@drawable/ic_breakfast"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/breakfast"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <ImageView
            android:id="@+id/addBreakfastBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_button"
            android:contentDescription="@string/todo1"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="#000000" />
    </LinearLayout>

    <!-- Lunch -->
    <LinearLayout
        android:id="@+id/lunchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/breakfastCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/todo2"
            android:src="@drawable/ic_lunch"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/lunch"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <ImageView
            android:id="@+id/addLunchBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_button"
            android:contentDescription="@string/todo54"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="#000000" />
    </LinearLayout>

    <!-- Dinner -->
    <LinearLayout
        android:id="@+id/dinnerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/lunchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/t2odo"
            android:src="@drawable/ic_dinner"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/dinner"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <ImageView
            android:id="@+id/addDinnerBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_button"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="#000000" />
    </LinearLayout>

    <!-- Water -->
    <LinearLayout
        android:id="@+id/waterCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/dinnerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_water"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/water"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/waterCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/to6do"
            android:gravity="end"
            android:importantForAccessibility="no"
            android:text="@string/_0_9"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/addWaterBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_button"
            android:baselineAligned="false"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="#000000"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:background="@drawable/rounded_card"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="DisableBaselineAlignment">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/homeSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/todo6"
                android:src="@drawable/ic_home"
                app:tint="@color/white"/>

            <TextView
                android:id="@+id/homeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/tod6o"
                android:importantForAccessibility="no"
                android:text="@string/home"
                android:textColor="@color/white"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/profileSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile"
                app:tint="#80FFFFFF"/>

            <TextView
                android:id="@+id/profileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/profile"
                android:textColor="#80FFFFFF"
                android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
