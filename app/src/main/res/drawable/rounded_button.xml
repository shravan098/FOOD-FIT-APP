<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CCFFFFFF"/> <!-- slightly darker white -->
            <corners android:radius="25dp"/>
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- normal white -->
            <corners android:radius="25dp"/>
            <stroke android:width="2dp" android:color="#EEEEEE"/> <!-- subtle border -->
        </shape>
    </item>

</selector>
